FROM ubuntu:22.04

# Install systemd and other dependencies
RUN apt-get update && \
    apt-get install -y \
    systemd \
    systemd-sysv \
    sudo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy the setup script
COPY setup-gophish.sh /root/setup-gophish.sh
RUN chmod +x /root/setup-gophish.sh

# Create a dummy gophish binary for testing
RUN mkdir -p /opt/gophish && \
    echo '#!/bin/bash\necho "Dummy gophish binary running..."' > /opt/gophish/gophish && \
    chmod +x /opt/gophish/gophish

# Enable systemd
ENV container docker
VOLUME ["/sys/fs/cgroup"]

CMD ["/lib/systemd/systemd"]